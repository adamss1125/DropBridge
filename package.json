{
  "name": "dropbridge",
  "version": "1.0.0",
  "description": "Private local file transfers between Windows and your browser",
  "author": "DropBridge",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:large": "node --test tests/large.mjs",
    "icons": "node scripts/icons.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "package": "npm run build && npm run icons && electron-builder --win portable nsis --x64",
    "package:dir": "npm run build && npm run icons && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "archiver": "^7.0.1",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "local.dropbridge.desktop",
    "productName": "DropBridge",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "DropBridge-${version}-${arch}-installer.${ext}"
    },
    "portable": {
      "artifactName": "DropBridge-${version}-${arch}-portable.${ext}"
    }
  }
}
